# ==============================================================================
# CONTOH KONFIGURASI ENVIRONMENT PRODUKSI (.env)
# SISTEM PRESENSI DIGITAL BIDTIK POLDA KALSEL (PresTIK)
# DOMAIN: https://prestik.tesmagang.site
# Catatan: Jangan sertakan kredensial asli ke dalam version control (git).
# ==============================================================================

APP_NAME="PresTIK"
APP_ENV=production
APP_KEY=base64:GUNAKAN_KEY_PRODUKSI_YANG_SUDAH_ADA
APP_DEBUG=false
APP_URL=https://prestik.tesmagang.site
APP_TIMEZONE=Asia/Makassar
APP_LOCALE=id
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# KONEKSI DATABASE PRODUKSI (MySQL / MariaDB)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=nama_database_produksi
DB_USERNAME=user_database_produksi
DB_PASSWORD=password_database_produksi

# PENGATURAN SESI & KEAMANAN COOKIE (HTTPS)
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# SESSION_DOMAIN disetel null agar otomatis mengikat origin domain yang sedang aktif
SESSION_DOMAIN=null
# Wajib true di environment produksi agar cookie sesi hanya dikirim via HTTPS
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# KONFIGURASI WEB PUSH (VAPID) UNTUK PENGINGAT PRESENSI OTOMATIS
VAPID_PUBLIC_KEY=masukkan_vapid_public_key_anda
VAPID_PRIVATE_KEY=masukkan_vapid_private_key_anda
VAPID_SUBJECT="mailto:admin@prestik.tesmagang.site"

# PENGATURAN FITUR PRESENSI
PRESENSI_MENIT_PENGINGAT=15
SURAT_MAX_SIZE_KB=2048

